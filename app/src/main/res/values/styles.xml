<resources>
    <!-- The brand's label style: monospace, caps, wide tracking. -->
    <style name="Eyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Every button on the brand's site is a 9999px pill with a 2px ring. -->
    <style name="Pill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">9999dp</item>
    </style>

    <style name="SettingSlider" parent="Widget.Material3.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="labelBehavior">gone</item>
        <item name="tickVisible">false</item>
        <item name="trackColorActive">@color/acm_teal</item>
        <item name="trackColorInactive">@color/light_gray</item>
        <item name="thumbColor">@color/acm_teal</item>
        <item name="haloColor">#332FBBAB</item>
    </style>
</resources>
